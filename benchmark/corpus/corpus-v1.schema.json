{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusId",
    "profileId",
    "metric",
    "license",
    "provenanceReference",
    "redistributionApproved",
    "limitations",
    "clips"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusId": { "type": "string", "minLength": 1 },
    "profileId": { "enum": ["english", "chinese", "auto"] },
    "metric": { "enum": ["WER", "CER", "AUTO_DIAGNOSTIC"] },
    "license": { "type": "string", "minLength": 1 },
    "provenanceReference": { "type": "string", "minLength": 1 },
    "redistributionApproved": { "const": true },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "audioPath",
          "audioSha256",
          "reference",
          "consentReference"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "audioPath": { "type": "string", "minLength": 1 },
          "audioSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "reference": { "type": "string", "minLength": 1 },
          "consentReference": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
