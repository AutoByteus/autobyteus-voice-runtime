{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intendedRelease",
    "releaseMatrix",
    "qualificationSet",
    "releaseEvidence",
    "catalog",
    "providerArchives",
    "publishedPayloadSetSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "intendedRelease": { "$ref": "#/$defs/release" },
    "releaseMatrix": { "$ref": "#/$defs/matrix" },
    "qualificationSet": { "$ref": "#/$defs/file" },
    "releaseEvidence": { "$ref": "#/$defs/file" },
    "catalog": { "$ref": "#/$defs/file" },
    "providerArchives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "items"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha" },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    },
    "publishedPayloadSetSha256": { "$ref": "#/$defs/sha" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeVersion", "releaseTag", "sourceCommit"],
      "properties": {
        "runtimeVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "releaseTag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrixId", "sha256"],
      "properties": {
        "matrixId": { "const": "voice-runtime-darwin-arm64-v1" },
        "sha256": { "$ref": "#/$defs/sha" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha" }
      }
    }
  }
}
