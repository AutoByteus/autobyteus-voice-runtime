{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decision",
    "failureCategory",
    "repository",
    "releaseTag",
    "attemptedAt",
    "verificationResultSha256",
    "release",
    "tagRef"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "decision": { "enum": ["release-deleted", "quarantine-failed"] },
    "failureCategory": { "type": ["string", "null"] },
    "repository": { "type": "string" },
    "releaseTag": { "type": "string" },
    "attemptedAt": { "type": "string", "format": "date-time" },
    "verificationResultSha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeId", "beforeStatus", "afterStatus"],
      "properties": {
        "beforeId": { "type": ["integer", "null"] },
        "beforeStatus": { "enum": ["present", "unknown"] },
        "afterStatus": { "enum": ["absent", "present", "unknown"] }
      }
    },
    "tagRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beforeSha",
        "beforeType",
        "afterSha",
        "afterType",
        "preserved"
      ],
      "properties": {
        "beforeSha": { "type": ["string", "null"] },
        "beforeType": { "type": ["string", "null"] },
        "afterSha": { "type": ["string", "null"] },
        "afterType": { "type": ["string", "null"] },
        "preserved": { "type": "boolean" }
      }
    }
  }
}
