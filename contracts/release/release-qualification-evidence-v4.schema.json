{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobyteus.local/contracts/release/release-qualification-evidence-v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "runtimeVersion",
    "releaseTag",
    "finalMainCommit",
    "releaseSourceAdmission",
    "releaseAdmissionVerification",
    "hostConstruction",
    "modelManifestAdmission",
    "matrix",
    "profiles",
    "expectedAssetNames",
    "executionCounts",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "artifactKind": {
      "const": "release-qualification-evidence"
    },
    "runtimeVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "finalMainCommit": {
      "type": "string",
      "pattern": "^(?!0{40})[a-f0-9]{40}$"
    },
    "releaseSourceAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "hostConstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "modelManifestAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profileId",
          "hostArchive",
          "hostSourceClosureSha256",
          "modelAdmissionRootSha256",
          "modelManifest",
          "compatibilityPairSha256",
          "hostDescriptorSha256",
          "hostFileManifestSha256",
          "hostSourceClosureSizeBytes"
        ],
        "properties": {
          "profileId": {
            "enum": ["english", "chinese"]
          },
          "hostArchive": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fileName", "sizeBytes", "sha256"],
            "properties": {
              "fileName": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "hostSourceClosureSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "modelAdmissionRootSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "modelManifest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fileName", "sizeBytes", "sha256"],
            "properties": {
              "fileName": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "compatibilityPairSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "hostDescriptorSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "hostFileManifestSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "hostSourceClosureSizeBytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "expectedAssetNames": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "executionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productTests", "modelDownloads", "providerLaunches"],
      "properties": {
        "productTests": {
          "const": 0
        },
        "modelDownloads": {
          "const": 0
        },
        "providerLaunches": {
          "const": 0
        }
      }
    },
    "decision": {
      "const": "pass"
    },
    "releaseAdmissionVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
