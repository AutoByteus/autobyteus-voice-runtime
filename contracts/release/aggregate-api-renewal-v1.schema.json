{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobyteus.org/contracts/release/aggregate-api-renewal-v1.schema.json",
  "title": "Aggregate API Renewal Record 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "repository",
    "packageVersion",
    "reviewedSourceCommit",
    "reviewedTestCommit",
    "api",
    "profileClosure",
    "retainedProfiles",
    "aggregateEvidence",
    "qualificationAuthority"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifactKind": {
      "const": "aggregate-api-renewal"
    },
    "repository": {
      "const": "AutoByteus/autobyteus-voice-runtime"
    },
    "packageVersion": {
      "const": "1.0.0"
    },
    "reviewedSourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "reviewedTestCommit": {
      "$ref": "#/$defs/commit"
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "decision",
        "coverageReport",
        "profileExecutionCount"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^API-REV-[0-9]{3,}$"
        },
        "decision": {
          "const": "pass"
        },
        "coverageReport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositoryPath", "gitBlobSha256", "contentSha256"],
          "properties": {
            "repositoryPath": {
              "type": "string",
              "pattern": "^tickets/done/voice-input-runtime-reliability/api-e2e-execution-coverage-report\\.md$"
            },
            "gitBlobSha256": {
              "$ref": "#/$defs/digest"
            },
            "contentSha256": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "profileExecutionCount": {
          "const": 0
        }
      }
    },
    "profileClosure": {
      "allOf": [
        {
          "$ref": "#/$defs/closure"
        },
        {
          "type": "object",
          "properties": {
            "closureId": {
              "const": "profile-closure-v1"
            }
          },
          "required": ["closureId"]
        }
      ]
    },
    "retainedProfiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/retainedArchive"
            },
            {
              "type": "object",
              "properties": {
                "profileId": {
                  "const": "english"
                }
              },
              "required": ["profileId"]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/retainedArchive"
            },
            {
              "type": "object",
              "properties": {
                "profileId": {
                  "const": "chinese"
                }
              },
              "required": ["profileId"]
            }
          ]
        }
      ]
    },
    "aggregateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualificationSet",
        "branchProjection",
        "branchProjectionVerification"
      ],
      "properties": {
        "qualificationSet": {
          "$ref": "#/$defs/aggregateItem"
        },
        "branchProjection": {
          "$ref": "#/$defs/aggregateItem"
        },
        "branchProjectionVerification": {
          "$ref": "#/$defs/aggregateItem"
        }
      }
    },
    "qualificationAuthority": {
      "allOf": [
        {
          "$ref": "#/$defs/closure"
        },
        {
          "type": "object",
          "properties": {
            "closureId": {
              "const": "qualification-authority-closure-v1"
            }
          },
          "required": ["closureId"]
        }
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^(?!0{40})[a-f0-9]{40}$"
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closureId", "inventorySha256", "treeSha256"],
      "properties": {
        "closureId": {
          "type": "string",
          "enum": ["profile-closure-v1", "qualification-authority-closure-v1"]
        },
        "inventorySha256": {
          "$ref": "#/$defs/digest"
        },
        "treeSha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "retainedArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "archive", "profileEvidence"],
      "properties": {
        "profileId": {
          "enum": ["english", "chinese"]
        },
        "archive": {
          "$ref": "#/$defs/fileIdentity"
        },
        "profileEvidence": {
          "$ref": "#/$defs/fileIdentity"
        }
      }
    },
    "aggregateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "prior", "byteIdentical"],
      "properties": {
        "current": {
          "$ref": "#/$defs/fileIdentity"
        },
        "prior": {
          "$ref": "#/$defs/fileIdentity"
        },
        "byteIdentical": {
          "type": "boolean"
        }
      }
    }
  }
}
