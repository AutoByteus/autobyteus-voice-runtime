{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobyteus.local/contracts/release/model-manifest-admission-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "sourceAdmission",
    "profiles",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifactKind": {
      "const": "model-manifest-admission"
    },
    "sourceAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profileId",
          "manifest",
          "modelAdmissionRootSha256",
          "executionClosureVerification",
          "branchProjectionSha256",
          "decision"
        ],
        "properties": {
          "profileId": {
            "enum": ["english", "chinese"]
          },
          "manifest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fileName", "sizeBytes", "sha256"],
            "properties": {
              "fileName": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "modelAdmissionRootSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "executionClosureVerification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fileName", "sizeBytes", "sha256"],
            "properties": {
              "fileName": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "branchProjectionSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "decision": {
            "const": "admitted"
          }
        }
      }
    },
    "decision": {
      "const": "pass"
    }
  }
}
