{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobyteus.local/contracts/release/release-admission-verification-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "releaseSourceAdmission",
    "focusedSourceCommit",
    "admittedSourceCommit",
    "authorityPromotionCommit",
    "workflowCheckoutCommit",
    "sourceClosurePolicy",
    "protectedMembers",
    "admittedRange",
    "postPromotionRange",
    "profiles",
    "checks",
    "decision"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifactKind": {
      "const": "release-admission-verification"
    },
    "releaseSourceAdmission": {
      "$ref": "#/$defs/identity"
    },
    "focusedSourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "admittedSourceCommit": {
      "$ref": "#/$defs/commit"
    },
    "authorityPromotionCommit": {
      "$ref": "#/$defs/commit"
    },
    "workflowCheckoutCommit": {
      "$ref": "#/$defs/commit"
    },
    "sourceClosurePolicy": {
      "$ref": "#/$defs/identity"
    },
    "protectedMembers": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "$ref": "#/$defs/protectedMember",
          "properties": {
            "fileName": {
              "const": "release/admission/v1.0.0-branch-catalog-projection-v3.json"
            }
          },
          "type": "object"
        },
        {
          "$ref": "#/$defs/protectedMember",
          "properties": {
            "fileName": {
              "const": "release/admission/v1.0.0-branch-catalog-projection-verification-v3.json"
            }
          },
          "type": "object"
        },
        {
          "$ref": "#/$defs/protectedMember",
          "properties": {
            "fileName": {
              "const": "release/admission/v1.0.0-chinese-profile-execution-closure-v2.json"
            }
          },
          "type": "object"
        },
        {
          "$ref": "#/$defs/protectedMember",
          "properties": {
            "fileName": {
              "const": "release/admission/v1.0.0-english-profile-execution-closure-v2.json"
            }
          },
          "type": "object"
        },
        {
          "$ref": "#/$defs/protectedMember",
          "properties": {
            "fileName": {
              "const": "release/admission/v1.0.0-focused-qualification-set-v3.json"
            }
          },
          "type": "object"
        },
        {
          "$ref": "#/$defs/protectedMember",
          "properties": {
            "fileName": {
              "const": "release/admission/v1.0.0-release-source-admission-v4.json"
            }
          },
          "type": "object"
        }
      ],
      "items": false
    },
    "admittedRange": {
      "$ref": "#/$defs/range"
    },
    "postPromotionRange": {
      "$ref": "#/$defs/range"
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/englishProfile"
        },
        {
          "$ref": "#/$defs/chineseProfile"
        }
      ],
      "items": false
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focusedAncestorOfAdmitted",
        "admittedAncestorOfPromotion",
        "promotionSingleParent",
        "promotionDirectChild",
        "promotionExactAdditions",
        "promotionUnique",
        "promotionAncestorOfWorkflow",
        "workflowCheckoutVerified",
        "maintainedMainVerified",
        "protectedMembersImmutable"
      ],
      "properties": {
        "focusedAncestorOfAdmitted": {
          "type": "boolean"
        },
        "admittedAncestorOfPromotion": {
          "type": "boolean"
        },
        "promotionSingleParent": {
          "type": "boolean"
        },
        "promotionDirectChild": {
          "type": "boolean"
        },
        "promotionExactAdditions": {
          "type": "boolean"
        },
        "promotionUnique": {
          "type": "boolean"
        },
        "promotionAncestorOfWorkflow": {
          "type": "boolean"
        },
        "workflowCheckoutVerified": {
          "type": "boolean"
        },
        "maintainedMainVerified": {
          "type": "boolean"
        },
        "protectedMembersImmutable": {
          "type": "boolean"
        }
      }
    },
    "decision": {
      "enum": ["pass", "blocked"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "pass"
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "checks": {
            "type": "object",
            "properties": {
              "focusedAncestorOfAdmitted": {
                "const": true
              },
              "admittedAncestorOfPromotion": {
                "const": true
              },
              "promotionSingleParent": {
                "const": true
              },
              "promotionDirectChild": {
                "const": true
              },
              "promotionExactAdditions": {
                "const": true
              },
              "promotionUnique": {
                "const": true
              },
              "promotionAncestorOfWorkflow": {
                "const": true
              },
              "workflowCheckoutVerified": {
                "const": true
              },
              "maintainedMainVerified": {
                "const": true
              },
              "protectedMembersImmutable": {
                "const": true
              }
            }
          },
          "admittedRange": {
            "type": "object",
            "properties": {
              "decision": {
                "const": "reuse-permitted"
              }
            }
          },
          "postPromotionRange": {
            "type": "object",
            "properties": {
              "decision": {
                "const": "reuse-permitted"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^(?!0{40})[a-f0-9]{40}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "protectedMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeBytes", "sha256"],
      "properties": {
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "classification": {
      "enum": [
        "profile-qualification-required",
        "focused-qualification-required",
        "aggregate-api-renewal-required",
        "release-pipeline-only",
        "documentation-record-only",
        "api-impact-review-required"
      ]
    },
    "change": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "path", "classification"],
          "properties": {
            "status": {
              "enum": ["A", "M", "D"]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "classification": {
              "$ref": "#/$defs/classification"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "oldPath", "newPath", "classification"],
          "properties": {
            "status": {
              "const": "R"
            },
            "oldPath": {
              "type": "string",
              "minLength": 1
            },
            "newPath": {
              "type": "string",
              "minLength": 1
            },
            "classification": {
              "$ref": "#/$defs/classification"
            }
          }
        }
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changedPaths", "changedPathsSha256", "decision"],
      "properties": {
        "changedPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "changedPathsSha256": {
          "$ref": "#/$defs/sha"
        },
        "decision": {
          "enum": [
            "reuse-permitted",
            "profile-qualification-required",
            "focused-qualification-required",
            "api-impact-review-required"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "focusedHostSourceClosure",
        "admittedHostSourceClosure",
        "workflowHostSourceClosure",
        "focusedToAdmittedEqual",
        "admittedToWorkflowEqual"
      ],
      "properties": {
        "profileId": {
          "enum": ["english", "chinese"]
        },
        "focusedHostSourceClosure": {
          "$ref": "#/$defs/contentIdentity"
        },
        "admittedHostSourceClosure": {
          "$ref": "#/$defs/contentIdentity"
        },
        "workflowHostSourceClosure": {
          "$ref": "#/$defs/contentIdentity"
        },
        "focusedToAdmittedEqual": {
          "const": true
        },
        "admittedToWorkflowEqual": {
          "const": true
        }
      }
    },
    "englishProfile": {
      "allOf": [
        {
          "$ref": "#/$defs/profile"
        },
        {
          "properties": {
            "profileId": {
              "const": "english"
            }
          },
          "type": "object"
        }
      ]
    },
    "chineseProfile": {
      "allOf": [
        {
          "$ref": "#/$defs/profile"
        },
        {
          "properties": {
            "profileId": {
              "const": "chinese"
            }
          },
          "type": "object"
        }
      ]
    }
  }
}
