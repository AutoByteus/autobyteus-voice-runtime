{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recipe",
    "releaseMatrix",
    "package",
    "repository",
    "inputs",
    "materializedTreeSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recipe": { "$ref": "#/$defs/file" },
    "releaseMatrix": { "$ref": "#/$defs/matrix" },
    "package": { "type": "object" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "lockSha256"],
      "properties": {
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "lockSha256": { "$ref": "#/$defs/sha" }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observed" }
    },
    "materializedTreeSha256": { "$ref": "#/$defs/sha" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^(english|chinese)-darwin-arm64-v1\\.json$"
        },
        "sha256": { "$ref": "#/$defs/sha" }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrixId", "sha256"],
      "properties": {
        "matrixId": { "type": "string" },
        "sha256": { "$ref": "#/$defs/sha" }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "role",
        "destination",
        "identity",
        "licenseComponentId"
      ],
      "properties": {
        "kind": { "enum": ["cache-object", "git-checkout", "repository-file"] },
        "role": { "type": "string" },
        "destination": { "type": "string" },
        "identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$"
        },
        "licenseComponentId": { "type": "string" }
      }
    }
  }
}
