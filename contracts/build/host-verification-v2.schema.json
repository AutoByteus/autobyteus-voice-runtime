{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobyteus.local/contracts/build/host-verification-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hostPackageId",
    "hostRoot",
    "archiveSha256",
    "descriptorSha256",
    "fileManifestSha256",
    "extractedSizeBytes",
    "entryCount",
    "modesVerified",
    "descriptorSchemaValid",
    "fileManifestSchemaValid",
    "modelPayloadAbsent"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "hostPackageId": { "type": "string", "minLength": 1 },
    "hostRoot": { "const": "host" },
    "archiveSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "descriptorSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fileManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "extractedSizeBytes": { "type": "integer", "minimum": 1 },
    "entryCount": { "type": "integer", "minimum": 1 },
    "modesVerified": { "const": true },
    "descriptorSchemaValid": { "const": true },
    "fileManifestSchemaValid": { "const": true },
    "modelPayloadAbsent": { "const": true }
  }
}
