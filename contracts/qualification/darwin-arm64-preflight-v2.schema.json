{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "target",
    "status",
    "checkedAt",
    "host",
    "power",
    "performanceEnvironment",
    "tools",
    "sandbox",
    "purge",
    "failureCategory"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "target": {
      "const": "darwin-arm64"
    },
    "status": {
      "enum": ["pass", "blocked"]
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "object"
    },
    "power": {
      "type": "object"
    },
    "tools": {
      "type": "object"
    },
    "sandbox": {
      "type": "object"
    },
    "purge": {
      "type": "object"
    },
    "failureCategory": {
      "type": ["string", "null"]
    },
    "performanceEnvironment": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "host": {
            "$ref": "#/$defs/host"
          },
          "power": {
            "$ref": "#/$defs/power"
          },
          "tools": {
            "$ref": "#/$defs/tools"
          },
          "sandbox": {
            "$ref": "#/$defs/sandbox"
          },
          "purge": {
            "$ref": "#/$defs/purge"
          },
          "failureCategory": {
            "const": null
          },
          "performanceEnvironment": {
            "$ref": "#/$defs/performanceEnvironment"
          }
        }
      },
      "else": {
        "properties": {
          "failureCategory": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "xcodeRanlibIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationPath",
        "linkTarget",
        "targetPath",
        "targetSha256"
      ],
      "properties": {
        "invocationPath": {
          "type": "string",
          "pattern": "^/"
        },
        "linkTarget": {
          "const": "libtool"
        },
        "targetPath": {
          "type": "string",
          "pattern": "^/"
        },
        "targetSha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture", "cpuModel", "totalMemoryBytes"],
      "properties": {
        "platform": {
          "const": "darwin"
        },
        "architecture": {
          "const": "arm64"
        },
        "cpuModel": {
          "const": "Apple M1 Max"
        },
        "totalMemoryBytes": {
          "type": "integer",
          "minimum": 68719476736
        }
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acConnected",
        "lowPowerModeOff",
        "caffeinateActive",
        "thermalNormal",
        "memoryPressureNormal"
      ],
      "properties": {
        "acConnected": {
          "const": true
        },
        "lowPowerModeOff": {
          "const": true
        },
        "caffeinateActive": {
          "const": true
        },
        "thermalNormal": {
          "const": true
        },
        "memoryPressureNormal": {
          "const": true
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "nodeExecutable",
        "goArchiveSha256",
        "goRootTreeSha256",
        "cmake",
        "cmakeExecutable",
        "appleClang",
        "appleClangExecutable",
        "appleClangCxxExecutable",
        "appleArExecutable",
        "appleRanlibExecutable",
        "appleLinkerExecutable",
        "appleLibtoolExecutable",
        "xcode",
        "sdk",
        "sdkPath",
        "sdkSettingsSha256",
        "sudoExecutable",
        "commandPaths"
      ],
      "properties": {
        "node": {
          "const": "v22.23.1"
        },
        "nodeExecutable": {
          "$ref": "#/$defs/identity"
        },
        "goArchiveSha256": {
          "$ref": "#/$defs/sha"
        },
        "goRootTreeSha256": {
          "$ref": "#/$defs/sha"
        },
        "cmake": {
          "const": "cmake version 4.3.3"
        },
        "cmakeExecutable": {
          "$ref": "#/$defs/identity"
        },
        "appleClang": {
          "const": "Apple clang version 17.0.0 (clang-1700.4.4.1)"
        },
        "appleClangExecutable": {
          "$ref": "#/$defs/identity"
        },
        "appleClangCxxExecutable": {
          "$ref": "#/$defs/identity"
        },
        "appleArExecutable": {
          "$ref": "#/$defs/identity"
        },
        "appleRanlibExecutable": {
          "$ref": "#/$defs/xcodeRanlibIdentity"
        },
        "appleLinkerExecutable": {
          "$ref": "#/$defs/identity"
        },
        "appleLibtoolExecutable": {
          "$ref": "#/$defs/identity"
        },
        "xcode": {
          "const": "Xcode 26.1.1\nBuild version 17B100"
        },
        "sdk": {
          "const": "26.1"
        },
        "sdkPath": {
          "type": "string",
          "pattern": "^/"
        },
        "sdkSettingsSha256": {
          "$ref": "#/$defs/sha"
        },
        "sudoExecutable": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "deviceId",
            "inode",
            "ownerUid",
            "ownerGid",
            "mode",
            "sizeBytes",
            "modifiedNanoseconds",
            "changedNanoseconds",
            "probe"
          ],
          "properties": {
            "path": {
              "const": "/usr/bin/sudo"
            },
            "deviceId": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "inode": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "ownerUid": {
              "const": 0
            },
            "ownerGid": {
              "const": 0
            },
            "mode": {
              "const": "4511"
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 1
            },
            "modifiedNanoseconds": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "changedNanoseconds": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "probe": {
              "type": "object",
              "additionalProperties": false,
              "required": ["args", "stdoutSha256", "stderrSha256"],
              "properties": {
                "args": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "const": "-V"
                    }
                  ],
                  "items": false,
                  "minItems": 1,
                  "maxItems": 1
                },
                "stdoutSha256": {
                  "$ref": "#/$defs/sha"
                },
                "stderrSha256": {
                  "$ref": "#/$defs/sha"
                }
              }
            }
          }
        },
        "commandPaths": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "/usr/bin/sandbox-exec",
            "/usr/bin/pmset",
            "/usr/bin/top",
            "/usr/sbin/sysctl",
            "/usr/bin/memory_pressure",
            "/usr/bin/caffeinate",
            "/usr/sbin/purge",
            "/usr/bin/pgrep",
            "/usr/bin/xcrun",
            "/usr/bin/xcodebuild",
            "/usr/bin/make",
            "/usr/bin/tar",
            "/bin/sh"
          ],
          "properties": {
            "/usr/bin/sandbox-exec": {
              "$ref": "#/$defs/identity"
            },
            "/usr/bin/pmset": {
              "$ref": "#/$defs/identity"
            },
            "/usr/bin/top": {
              "$ref": "#/$defs/identity"
            },
            "/usr/sbin/sysctl": {
              "$ref": "#/$defs/identity"
            },
            "/usr/bin/memory_pressure": {
              "$ref": "#/$defs/identity"
            },
            "/usr/bin/caffeinate": {
              "$ref": "#/$defs/identity"
            },
            "/usr/sbin/purge": {
              "$ref": "#/$defs/identity"
            },
            "/usr/bin/pgrep": {
              "$ref": "#/$defs/identity"
            },
            "/usr/bin/xcrun": {
              "$ref": "#/$defs/identity"
            },
            "/usr/bin/xcodebuild": {
              "$ref": "#/$defs/identity"
            },
            "/usr/bin/make": {
              "$ref": "#/$defs/identity"
            },
            "/usr/bin/tar": {
              "$ref": "#/$defs/identity"
            },
            "/bin/sh": {
              "$ref": "#/$defs/identity"
            }
          }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "profileSha256",
        "networkDenied",
        "localOperationsAllowed"
      ],
      "properties": {
        "profile": {
          "const": "benchmark/sandbox/darwin-arm64-network-denied-v1.sb"
        },
        "profileSha256": {
          "$ref": "#/$defs/sha"
        },
        "networkDenied": {
          "const": true
        },
        "localOperationsAllowed": {
          "const": true
        }
      }
    },
    "purge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "nonInteractivePass",
        "sudoExecutableIdentitySha256"
      ],
      "properties": {
        "command": {
          "const": "/usr/bin/sudo -n /usr/sbin/purge"
        },
        "nonInteractivePass": {
          "const": true
        },
        "sudoExecutableIdentitySha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "performanceEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "cpuIdleSamples",
        "averageIdlePercent",
        "taskOwnedCompetingProcesses",
        "topConsumerProcessNames"
      ],
      "properties": {
        "classification": {
          "enum": ["controlled", "loaded-host"]
        },
        "cpuIdleSamples": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "averageIdlePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "taskOwnedCompetingProcesses": {
          "type": "object",
          "additionalProperties": false,
          "required": ["detected", "processNames"],
          "properties": {
            "detected": {
              "type": "boolean"
            },
            "processNames": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._+-]{1,128}$"
              }
            }
          }
        },
        "topConsumerProcessNames": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._+-]{1,128}$"
          }
        }
      }
    }
  }
}
