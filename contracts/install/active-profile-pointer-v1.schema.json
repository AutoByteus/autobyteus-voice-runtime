{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobyteus.local/contracts/install/active-profile-pointer-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "target",
    "installationId",
    "selectorGeneration",
    "activationRelativePath",
    "activationSha256",
    "compatibilityPairSha256",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "enum": ["english", "chinese"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture"],
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["darwin"]
        },
        "architecture": {
          "type": "string",
          "enum": ["arm64"]
        }
      }
    },
    "installationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "selectorGeneration": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "activationRelativePath": {
      "type": "string",
      "pattern": "^activations/[0-9a-f-]+/profile-activation-v1\\.json$"
    },
    "activationSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compatibilityPairSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
