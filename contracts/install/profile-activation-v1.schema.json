{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobyteus.local/contracts/install/profile-activation-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "installationId",
    "profileId",
    "languageMode",
    "target",
    "catalog",
    "host",
    "model",
    "compatibilityPairSha256",
    "capabilityDigest",
    "decision",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "installationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "profileId": {
      "type": "string",
      "enum": ["english", "chinese"]
    },
    "languageMode": {
      "type": "string",
      "enum": ["en", "zh"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture"],
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["darwin"]
        },
        "architecture": {
          "type": "string",
          "enum": ["arm64"]
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostPackageId",
        "providerId",
        "descriptorSha256",
        "fileManifestSha256",
        "hostSourceClosureSha256",
        "modelAdmissionRootSha256",
        "compatibilityRequirementSha256"
      ],
      "properties": {
        "hostPackageId": {
          "type": "string",
          "minLength": 1
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "descriptorSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fileManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hostSourceClosureSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "modelAdmissionRootSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compatibilityRequirementSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelAssetId",
        "modelId",
        "manifestSha256",
        "revision",
        "layoutId",
        "treeSha256",
        "files"
      ],
      "properties": {
        "modelAssetId": {
          "type": "string",
          "minLength": 1
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "layoutId": {
          "type": "string",
          "minLength": 1
        },
        "treeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role", "sizeBytes", "sha256", "mode"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._/-]+$"
              },
              "role": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]+$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "mode": {
                "type": "string",
                "enum": ["read-only"]
              }
            }
          }
        }
      }
    },
    "compatibilityPairSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilityDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "const": "active"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
