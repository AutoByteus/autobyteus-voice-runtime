{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "sessionId",
    "profileId",
    "expected"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "const": 1 },
    "sessionId": { "type": "string", "format": "uuid" },
    "profileId": { "enum": ["english", "chinese", "auto"] },
    "expected": { "$ref": "#/$defs/expected" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "providerId",
        "modelId",
        "languageMode",
        "platform",
        "architecture",
        "descriptorSha256",
        "fileManifestSha256",
        "capabilityDigest"
      ],
      "properties": {
        "packageId": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "languageMode": { "enum": ["en", "zh", "auto"] },
        "platform": { "enum": ["darwin", "linux", "win32"] },
        "architecture": { "enum": ["arm64", "x64"] },
        "descriptorSha256": { "$ref": "#/$defs/sha" },
        "fileManifestSha256": { "$ref": "#/$defs/sha" },
        "capabilityDigest": { "$ref": "#/$defs/sha" }
      }
    }
  }
}
