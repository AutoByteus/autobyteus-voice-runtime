{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobyteus.local/contracts/model/model-compatibility-requirement-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerId",
    "profileId",
    "languageMode",
    "target",
    "engine",
    "acceptedModelManifestSchemaVersion",
    "model",
    "requiredFiles",
    "capabilityDigest",
    "modelTreeAlgorithm"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "profileId": {
      "type": "string",
      "enum": ["english", "chinese"]
    },
    "languageMode": {
      "type": "string",
      "enum": ["en", "zh"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture"],
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["darwin"]
        },
        "architecture": {
          "type": "string",
          "enum": ["arm64"]
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "configurationSha256"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "configurationSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "acceptedModelManifestSchemaVersion": {
      "const": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "family", "size", "precision", "layoutId"],
      "properties": {
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "type": "string",
          "minLength": 1
        },
        "layoutId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requiredFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          }
        }
      }
    },
    "capabilityDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "modelTreeAlgorithm": {
      "const": "canonical-path-size-sha256-v1"
    }
  }
}
