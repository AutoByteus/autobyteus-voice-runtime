{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobyteus.local/contracts/model/model-asset-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "modelAssetId",
    "modelId",
    "family",
    "size",
    "precision",
    "revision",
    "layoutId",
    "files",
    "totalSizeBytes",
    "modelTreeSha256",
    "compatibleHosts",
    "downloadPolicy",
    "notice",
    "license"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "modelAssetId": {
      "type": "string",
      "minLength": 1
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "string",
      "minLength": 1
    },
    "precision": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "layoutId": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "sizeBytes",
          "sha256",
          "mode",
          "url",
          "revision"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mode": {
            "type": "string",
            "enum": ["read-only"]
          },
          "url": {
            "type": "string",
            "pattern": "^https://huggingface\\.co/[^?#]+/resolve/[a-f0-9]{40}/[^?#]+$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    },
    "totalSizeBytes": {
      "type": "integer",
      "minimum": 1
    },
    "modelTreeSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compatibleHosts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerId",
          "platform",
          "architecture",
          "engineKind",
          "engineVersion",
          "engineConfigurationSha256",
          "compatibilityRequirementSha256"
        ],
        "properties": {
          "providerId": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "enum": ["darwin"]
          },
          "architecture": {
            "type": "string",
            "enum": ["arm64"]
          },
          "engineKind": {
            "type": "string",
            "minLength": 1
          },
          "engineVersion": {
            "type": "string",
            "minLength": 1
          },
          "engineConfigurationSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "compatibilityRequirementSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "downloadPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialOrigin",
        "httpsOnly",
        "publicNetworkRedirectsOnly",
        "maxRedirects",
        "connectTimeoutMs",
        "readIdleTimeoutMs",
        "overallFileTimeoutMs",
        "resume"
      ],
      "properties": {
        "initialOrigin": {
          "const": "https://huggingface.co"
        },
        "httpsOnly": {
          "const": true
        },
        "publicNetworkRedirectsOnly": {
          "const": true
        },
        "maxRedirects": {
          "const": 5
        },
        "connectTimeoutMs": {
          "const": 10000
        },
        "readIdleTimeoutMs": {
          "const": 30000
        },
        "overallFileTimeoutMs": {
          "const": 7200000
        },
        "resume": {
          "const": "range-if-validator-matches-otherwise-restart"
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "THIRD_PARTY_NOTICES.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "identity"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://huggingface\\.co/[^?#]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
