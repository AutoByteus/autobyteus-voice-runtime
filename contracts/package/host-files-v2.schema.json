{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobyteus.local/contracts/package/host-files-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hostPackageId", "files"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "hostPackageId": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "sizeBytes", "mode"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "string",
            "enum": ["executable", "read-only"]
          }
        }
      }
    }
  }
}
