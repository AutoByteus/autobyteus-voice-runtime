{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "matrixId", "supportStatement", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "matrixId": { "const": "voice-runtime-darwin-arm64-v1" },
    "supportStatement": { "const": "macOS Apple Silicon only" },
    "entries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "languageMode",
        "platform",
        "architecture",
        "packageId",
        "providerId",
        "modelId",
        "decision",
        "recipeFileName"
      ],
      "properties": {
        "profileId": { "enum": ["english", "chinese"] },
        "languageMode": { "enum": ["en", "zh"] },
        "platform": { "const": "darwin" },
        "architecture": { "const": "arm64" },
        "packageId": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["preserve", "select"] },
        "recipeFileName": {
          "type": "string",
          "pattern": "^(english|chinese)-darwin-arm64-v1\\.json$"
        }
      }
    }
  }
}
