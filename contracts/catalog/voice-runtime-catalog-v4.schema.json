{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobyteus.local/contracts/catalog/voice-runtime-catalog-v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "releaseVersion", "entries"],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "catalogId": {
      "const": "voice-runtime-catalog-v4"
    },
    "releaseVersion": {
      "const": "1.0.0"
    },
    "entries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/catalogEntry"
            },
            {
              "type": "object",
              "properties": {
                "profileId": {
                  "const": "english"
                },
                "languageMode": {
                  "const": "en"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/catalogEntry"
            },
            {
              "type": "object",
              "properties": {
                "profileId": {
                  "const": "chinese"
                },
                "languageMode": {
                  "const": "zh"
                }
              }
            }
          ]
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "catalogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "languageMode",
        "target",
        "providerId",
        "modelId",
        "capabilityDigest",
        "host",
        "hostAuthority",
        "model",
        "compatibilityPairSha256",
        "supportStatement"
      ],
      "properties": {
        "profileId": {
          "type": "string",
          "enum": ["english", "chinese"]
        },
        "languageMode": {
          "type": "string",
          "enum": ["en", "zh"]
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "architecture"],
          "properties": {
            "platform": {
              "type": "string",
              "enum": ["darwin"]
            },
            "architecture": {
              "type": "string",
              "enum": ["arm64"]
            }
          }
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "capabilityDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "archive",
            "hostPackageId",
            "descriptorSha256",
            "fileManifestSha256",
            "compatibilityRequirementSha256",
            "launcherPath",
            "modelManagerPath"
          ],
          "properties": {
            "archive": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fileName", "sizeBytes", "sha256", "url"],
              "properties": {
                "fileName": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://[^?#]+$"
                }
              }
            },
            "hostPackageId": {
              "type": "string",
              "minLength": 1
            },
            "descriptorSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "fileManifestSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "compatibilityRequirementSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "launcherPath": {
              "const": "bin/voice-provider"
            },
            "modelManagerPath": {
              "const": "bin/voice-model-manager"
            }
          }
        },
        "hostAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostSourceClosure", "modelAdmissionRoot"],
          "properties": {
            "hostSourceClosure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fileName", "sizeBytes", "sha256"],
              "properties": {
                "fileName": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "modelAdmissionRoot": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fileName", "sizeBytes", "sha256"],
              "properties": {
                "fileName": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest",
            "modelAssetId",
            "revision",
            "layoutId",
            "modelTreeSha256",
            "totalSizeBytes"
          ],
          "properties": {
            "manifest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fileName", "sizeBytes", "sha256", "url"],
              "properties": {
                "fileName": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "sizeBytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://[^?#]+$"
                }
              }
            },
            "modelAssetId": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "layoutId": {
              "type": "string",
              "minLength": 1
            },
            "modelTreeSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "totalSizeBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "compatibilityPairSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "supportStatement": {
          "const": "macOS Apple Silicon only"
        }
      }
    }
  }
}
