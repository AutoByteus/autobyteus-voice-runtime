{
  "name": "@autobyteus/voice-input-runtime",
  "version": "1.0.0",
  "private": true,
  "description": "Self-contained AutoByteus voice-to-text provider",
  "license": "SEE LICENSES IN THIRD_PARTY_NOTICES.md",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs && npm test",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:model": "node scripts/build-model.mjs",
    "manifest": "node scripts/generate-manifest.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "opencc-js": "1.4.1",
    "sherpa-onnx-node": "1.13.4"
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "1.13.4",
    "sherpa-onnx-darwin-x64": "1.13.4",
    "sherpa-onnx-linux-x64": "1.13.4",
    "sherpa-onnx-win-x64": "1.13.4"
  }
}
