--- resolve_cases.sh
#!/bin/bash
# Renders the resolve step's ${{ }} expressions the way GitHub would for each event and runs it with bash.
T=/tmp/ab655/impl/resolve.tmpl
run() { # label event ref_type ref_name input_version input_publish
  out=$(mktemp); script=$(sed -e "s|\${{ github.event_name }}|$2|g" -e "s|\${{ inputs.runtime_version }}|$5|g" -e "s|\${{ inputs.publish }}|$6|g" "$T")
  GITHUB_OUTPUT=$out GITHUB_REF_TYPE=$3 GITHUB_REF_NAME=$4 GITHUB_SHA=8d154d9a1b2c3d4e5f60718293a4b5c6d7e8f901 bash -euo pipefail -c "$script"
  echo "== $1"; cat "$out"; rm -f "$out"
}
run "tag push v0.3.2" push tag v0.3.2 "" ""
run "push to release/0.3" push branch release/0.3 "" ""
run "dispatch 0.3.2 publish=false" workflow_dispatch branch codex/voice-runtime-release-runner 0.3.2 false
run "dispatch v0.3.2 publish=true" workflow_dispatch branch release/0.3 v0.3.2 true
run "dispatch 0.3.2 publish empty (input omitted by an API call)" workflow_dispatch branch release/0.3 0.3.2 ""
