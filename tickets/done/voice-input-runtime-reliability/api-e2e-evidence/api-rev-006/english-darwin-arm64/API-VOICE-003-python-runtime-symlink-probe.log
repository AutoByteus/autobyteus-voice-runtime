   137	async function verifyRuntimeTree(root, wheels) {
   138	  const expected = new Map(
   139	    wheels
   140	      .filter((wheel) => !BUILD_ONLY.has(canonical(wheel.name)))
   141	      .map((wheel) => [canonical(wheel.name), wheel.version]),
   142	  );
