   147	    const metadata = await fs.readFile(path.join(root, relative), "utf8");
   148	    const name = /^Name:\s*(.+)$/im.exec(metadata)?.[1]?.trim();
   149	    const version = /^Version:\s*(.+)$/im.exec(metadata)?.[1]?.trim();
   150	    if (!name || !version)
   151	      throw new Error("Installed wheel metadata is invalid.");
   152	    installed.set(canonical(name), version);
   153	  }
   154	  if (
   155	    expected.size !== installed.size ||
   156	    [...expected].some(([name, version]) => installed.get(name) !== version)
   157	  )
   158	    throw new Error(
