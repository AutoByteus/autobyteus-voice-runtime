--- script
#!/bin/sh
# Live start-failure cases. Each line: case, exit code, stdout, stderr.
run() {
  name="$1"; shift
  out=$(mktemp /tmp/ab655/impl/out.XXXX); err=$(mktemp /tmp/ab655/impl/err.XXXX)
  start=$(/usr/bin/python3 -c 'import time;print(int(time.time()*1000))')
  "$@" </dev/null >"$out" 2>"$err"; code=$?
  end=$(/usr/bin/python3 -c 'import time;print(int(time.time()*1000))')
  echo "== $name"
  echo "exit: $code  tookMs: $((end-start))"
  echo "stdout lines: $(wc -l <"$out" | tr -d ' ')"; cat "$out"
  echo "stderr lines: $(wc -l <"$err" | tr -d ' ')"; cat "$err"
  rm -f "$out" "$err"
}
export HOME=/tmp/ab655/home HF_HUB_OFFLINE=1
run "mlx, missing model folder" /tmp/ab655/impl/mlx-entry.sh serve --backend mlx --model-path /tmp/ab655/impl/no-such-model
run "faster-whisper, missing model folder" /tmp/ab655/impl/fw-entry.sh serve --backend faster-whisper --model-path /tmp/ab655/impl/no-such-model
run "mlx, corrupt model" /tmp/ab655/impl/mlx-entry.sh serve --backend mlx --model-path /tmp/ab655/broken/mlx-corrupt
