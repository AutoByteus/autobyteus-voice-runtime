--- script
"""Live AC-005: after ready, an unsupported request type and a missing audio file are answered ok:false and the worker keeps serving."""
import json, subprocess, sys, time
entry, backend, model, clip = sys.argv[1:5]
p = subprocess.Popen([entry, "serve", "--backend", backend, "--model-path", model], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
print(json.dumps({"event": "first-message", "message": json.loads(p.stdout.readline())}))
reqs = [
    {"type": "unknown-request", "requestId": "u1"},
    {"type": "transcribe-file", "requestId": "m1", "audioPath": "/tmp/ab655/impl/no-such-clip.wav", "languageMode": "auto"},
    {"type": "transcribe-file", "requestId": "t1", "audioPath": clip, "languageMode": "auto"},
]
for r in reqs:
    p.stdin.write(json.dumps(r) + "\n"); p.stdin.flush()
    print(json.dumps({"event": "reply", "sent": r["type"], "reply": json.loads(p.stdout.readline())}))
p.stdin.close(); code = p.wait(timeout=60)
print(json.dumps({"event": "exit", "code": code}))
