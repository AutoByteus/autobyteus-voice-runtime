{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autobyteus.com/schemas/voice-input/provider-session-config-v1.schema.json",
  "title": "AutoByteus Voice Input Provider Session Configuration V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "runtimeRoot", "runtimeDescriptor", "modelRoot", "modelDescriptor", "expected", "languageMode"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "const": 1 },
    "runtimeRoot": { "type": "string", "minLength": 1 },
    "runtimeDescriptor": { "$ref": "#/$defs/descriptorReference" },
    "modelRoot": { "type": "string", "minLength": 1 },
    "modelDescriptor": { "$ref": "#/$defs/descriptorReference" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "host", "engine", "model", "capabilities"],
      "properties": {
        "runtime": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version", "buildCommit"],
          "properties": {
            "id": { "const": "voice-input" },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "buildCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
          }
        },
        "host": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "version", "platform", "arch"],
          "properties": {
            "kind": { "const": "bundled-node" },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "platform": { "enum": ["darwin", "linux", "win32"] },
            "arch": { "enum": ["arm64", "x64"] }
          }
        },
        "engine": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "version", "gitSha1"],
          "properties": {
            "kind": { "const": "sherpa-onnx" },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "gitSha1": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" }
          }
        },
        "model": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "version", "modelType", "sha256"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "modelType": { "enum": ["sense-voice", "whisper"] },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    },
    "languageMode": { "enum": ["auto", "en", "zh"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "descriptorReference": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["languageModes", "inverseTextNormalization", "simplifiedChineseNormalization", "maxInFlightRequests"],
      "properties": {
        "languageModes": { "const": ["auto", "en", "zh"] },
        "inverseTextNormalization": { "const": true },
        "simplifiedChineseNormalization": { "const": true },
        "maxInFlightRequests": { "const": 1 }
      }
    }
  }
}
